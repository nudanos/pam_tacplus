@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: LGPL-3.0-or-later
+ * include=FILE reads server=, secret= and timeout= lines from a root-only
+ * file, so the shared secret need not sit in world-readable /etc/pam.d. */
+#include "config.h"
+#include "support.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+    char path[] = "/tmp/tacplus_servers_XXXXXX";
+    int fd = mkstemp(path);
+    FILE *f = fdopen(fd, "w");
+    fprintf(f, "# NuDanOS TACACS+ servers\nsecret=s3cr3t\nserver=127.0.0.1\n\ntimeout=7\n");
+    fclose(f);
+    char arg[300];
+    snprintf(arg, sizeof arg, "include=%s", path);
+    const char *argv[] = {"login=login", arg};
+    _pam_parse(2, argv);
+    unlink(path);
+    if (tac_srv_no != 1 || tac_srv[0].key == NULL || strcmp(tac_srv[0].key, "s3cr3t") != 0 ||
+        tac_timeout != 7 || strcmp(tac_login, "login") != 0) {
+        printf("include_test: FAIL: servers=%u key=%s timeout=%lu login=%s\n", tac_srv_no,
+               tac_srv[0].key ? tac_srv[0].key : "(null)", tac_timeout, tac_login);
+        return 1;
+    }
+    const char *missing[] = {"include=/nonexistent/tacplus_servers"};
+    _pam_parse(1, missing);
+    if (tac_srv_no != 0) {
+        printf("include_test: FAIL: a missing include file gave %u servers\n", tac_srv_no);
+        return 1;
+    }
+    printf("include_test: OK\n");
+    return 0;
+}
