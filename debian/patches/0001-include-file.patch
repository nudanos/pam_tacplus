--- a/support.c	2026-10-06 06:56:48
+++ b/support.c	2026-10-06 06:59:29
@@ -245,6 +245,57 @@
     }
 }
 
+/* NuDanOS: include=FILE adds the server=, secret= and timeout= lines of FILE
+ * (blank lines and # comments skipped) to the module arguments, as the
+ * Cumulus/VyOS pam_tacplus does, so a shared secret can live in a root-only
+ * file instead of world-readable /etc/pam.d. *out holds copies until
+ * free_args(); a missing file is logged and contributes nothing. */
+static int expand_includes(int argc, const char **argv, char ***out) {
+    int n = 0, cap = argc + 16;
+    char **list = calloc(cap, sizeof(char *));
+
+    if (list == NULL)
+        return -1;
+    for (; argc-- > 0; ++argv) {
+        if (strncmp(*argv, "include=", 8) != 0) {
+            if (n + 1 >= cap && (list = realloc(list, (cap *= 2) * sizeof(char *))) == NULL)
+                return -1;
+            list[n++] = strdup(*argv);
+            continue;
+        }
+        FILE *f = fopen(*argv + 8, "r");
+        if (f == NULL) {
+            _pam_log(LOG_ERR, "cannot read %s: %m", *argv + 8);
+            continue;
+        }
+        char line[512];
+        while (fgets(line, sizeof line, f) != NULL) {
+            line[strcspn(line, "\r\n")] = '\0';
+            if (line[0] == '\0' || line[0] == '#')
+                continue;
+            if (n + 1 >= cap && (list = realloc(list, (cap *= 2) * sizeof(char *))) == NULL) {
+                fclose(f);
+                return -1;
+            }
+            list[n++] = strdup(line);
+        }
+        fclose(f);
+    }
+    list[n] = NULL;
+    *out = list;
+    return n;
+}
+
+static void free_args(char **list) {
+    char **p;
+
+    if (list == NULL)
+        return;
+    for (p = list; *p != NULL; p++)
+        free(*p);
+    free(list);
+}
+
 int _pam_parse(int argc, const char **argv) {
     int ctrl = 0;
     const char *current_secret = NULL;
@@ -261,6 +312,13 @@
     tac_prompt[0] = 0;
     tac_login[0] = 0;
 
+    char **expanded = NULL;
+    int n_expanded = expand_includes(argc, argv, &expanded);
+    if (n_expanded >= 0) {
+        argc = n_expanded;
+        argv = (const char **)expanded;
+    }
+
